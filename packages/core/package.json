{
  "name": "@sitepull/core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external playwright --external archiver",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/core/src"
  },
  "dependencies": {
    "@sitepull/contracts": "workspace:*",
    "archiver": "^8.0.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.10.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
