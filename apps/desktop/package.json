{
  "name": "@sitepull/desktop",
  "version": "0.2.0",
  "private": true,
  "productName": "Sitepull",
  "description": "Capture browser-delivered design references into inspectable local artifacts.",
  "author": "Isaiah Neal",
  "license": "MIT",
  "homepage": "https://github.com/isaiahneal/sitepull",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "pnpm install:packaged-browser && electron-forge start",
    "install:packaged-browser": "node scripts/install-packaged-browser.mjs",
    "prepare:makers": "node scripts/prepare-makers.mjs",
    "build": "pnpm install:packaged-browser && electron-forge package",
    "package": "pnpm install:packaged-browser && electron-forge package",
    "package:mac": "pnpm install:packaged-browser && electron-forge package --platform=darwin",
    "package:linux": "pnpm install:packaged-browser && electron-forge package --platform=linux",
    "package:windows": "pnpm install:packaged-browser && electron-forge package --platform=win32",
    "make": "pnpm install:packaged-browser && pnpm prepare:makers && electron-forge make",
    "make:mac": "pnpm install:packaged-browser && pnpm prepare:makers && electron-forge make --platform=darwin",
    "make:linux": "pnpm install:packaged-browser && pnpm prepare:makers && electron-forge make --platform=linux",
    "make:windows": "pnpm install:packaged-browser && pnpm prepare:makers && electron-forge make --platform=win32",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run apps/desktop/src/main"
  },
  "dependencies": {
    "@sitepull/contracts": "workspace:*",
    "@sitepull/core": "workspace:*",
    "@base-ui/react": "1.7.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "1.37.0",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
